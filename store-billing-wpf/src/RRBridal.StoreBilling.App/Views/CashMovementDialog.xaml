<Window x:Class="RRBridal.StoreBilling.App.Views.CashMovementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment voucher — Cash withdrawal"
        Width="440"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{StaticResource FontFamilyPrimary}"
        Background="{StaticResource BrushBackground}">
    <Border Style="{StaticResource CardBorder}" Margin="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Payment voucher" Style="{StaticResource TextSectionTitle}"/>
            <TextBlock Grid.Row="1" Text="Posts a cash withdrawal for today’s open day session."
                       Foreground="{StaticResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Amount (₹)" Style="{StaticResource FormFieldLabel}"/>
                <TextBox x:Name="AmountBox" Style="{StaticResource RoundedTextBox}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Description" Style="{StaticResource FormFieldLabel}"/>
                <TextBox x:Name="DescriptionBox" Style="{StaticResource RoundedTextBox}"
                         MinHeight="52" TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_OnClick"/>
                <Button Content="Post withdrawal" Style="{StaticResource PrimaryButton}" MinWidth="130"
                        IsDefault="True" Click="Post_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
