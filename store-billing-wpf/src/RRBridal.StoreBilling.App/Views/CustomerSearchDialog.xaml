<Window x:Class="RRBridal.StoreBilling.App.Views.CustomerSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Customer"
        Width="780"
        Height="500"
        MinHeight="380"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontFamilyPrimary}"
        Background="{StaticResource BrushBackground}"
        AutomationProperties.AutomationId="customer-search-dialog"
        AutomationProperties.Name="Find Customer">
    <Border Style="{StaticResource CardBorder}" Margin="16" Padding="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Search by name, phone, or email (local + central)" Style="{StaticResource TextSectionTitle}"/>

        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource RoundedTextBox}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchBox_OnKeyDown"
                     Margin="0,0,8,0" AutomationProperties.AutomationId="customer-search-search-input" AutomationProperties.Name="Search"/>
            <Button Grid.Column="1" Content="Search" Style="{StaticResource PrimaryButton}" Click="Search_OnClick" Width="100" AutomationProperties.AutomationId="customer-search-search-button" AutomationProperties.Name="Search"/>
        </Grid>

        <ListView Grid.Row="2"
                  x:Name="ResultsList"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedItem}"
                  MouseDoubleClick="Results_OnMouseDoubleClick"
                  BorderBrush="{StaticResource BrushBorder}"
                  Background="{StaticResource BrushSurface}" AutomationProperties.AutomationId="customer-search-results-list" AutomationProperties.Name="Results List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Source}" Width="60"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="170"/>
                    <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding Phone}" Width="120"/>
                    <GridViewColumn Header="GSTIN" DisplayMemberBinding="{Binding Gstin}" Width="140"/>
                    <GridViewColumn Header="City" DisplayMemberBinding="{Binding City}" Width="90"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding FullAddress}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Register New Customer" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="RegisterNew_OnClick" AutomationProperties.AutomationId="customer-search-register-new-customer-button" AutomationProperties.Name="Register New Customer"/>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Width="80" IsCancel="True" Click="Cancel_OnClick" AutomationProperties.AutomationId="customer-search-cancel-button" AutomationProperties.Name="Cancel"/>
                <Button Content="Select" Style="{StaticResource PrimaryButton}" Width="100" Click="Select_OnClick" AutomationProperties.AutomationId="customer-search-select-button" AutomationProperties.Name="Select"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
