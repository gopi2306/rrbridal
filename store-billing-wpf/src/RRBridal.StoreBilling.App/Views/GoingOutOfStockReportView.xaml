<UserControl x:Class="RRBridal.StoreBilling.App.Views.GoingOutOfStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:RRBridal.StoreBilling.App.Services.Ui"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1180"
             AutomationProperties.AutomationId="going-out-of-stock-report-page"
             AutomationProperties.Name="Going out of stock report"
             Background="{StaticResource BrushBackground}">
    <Grid Margin="0,4,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Store SKUs at or below shelf/reorder threshold (including zero qty). Critical uses min stock when set."
                       Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,280,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Style="{StaticResource OutlineButton}" MinWidth="100"
                        Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="Download Excel" Style="{StaticResource PrimaryButton}" MinWidth="140"
                        Command="{Binding DownloadExcelCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
                <StackPanel Width="280" Margin="0,0,12,6">
                    <TextBlock Text="SKU, name, or supplier" Style="{StaticResource FilterFieldLabel}"/>
                    <TextBox Style="{StaticResource RoundedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search SKU, product name, or supplier"/>
                </StackPanel>
                <StackPanel Width="160" Margin="0,0,12,6">
                    <TextBlock Text="Status" Style="{StaticResource FilterFieldLabel}"/>
                    <ComboBox Style="{StaticResource RoundedComboBox}"
                              ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Label"/>
                </StackPanel>
                <Button Content="Search" Style="{StaticResource PrimaryButton}" MinWidth="110"
                        Height="34" VerticalAlignment="Bottom" Margin="0,0,0,6"
                        Command="{Binding SearchCommand}" IsDefault="True"/>
            </WrapPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Border Padding="10,7" CornerRadius="6" Background="{StaticResource BrushSurface}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border Margin="0,8,0,0" Padding="10" CornerRadius="6" Background="#FFF7ED"
                    Visibility="{Binding IsTruncated, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TruncatedMessage}" Foreground="#9A3412"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <UniformGrid Margin="0,10,0,0"
                         ui:UniformGridColumnsBehavior.IsEnabled="True"
                         ui:UniformGridColumnsBehavior.CompactColumns="2"
                         ui:UniformGridColumnsBehavior.MediumColumns="2"
                         ui:UniformGridColumnsBehavior.WideColumns="4">
                <Border Style="{StaticResource MetricCardAccent}">
                    <StackPanel>
                        <TextBlock Text="SKUs" Style="{StaticResource FilterFieldLabel}"/>
                        <TextBlock Text="{Binding SkuCount}" Style="{StaticResource MetricValueAccent}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Critical" Style="{StaticResource FilterFieldLabel}"/>
                        <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Low" Style="{StaticResource FilterFieldLabel}"/>
                        <TextBlock Text="{Binding LowCount}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="At zero" Style="{StaticResource FilterFieldLabel}"/>
                        <TextBlock Text="{Binding ZeroQtyCount}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="8">
            <Grid>
                <TextBlock Text="No matching items going out of stock."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource PageSubtitle}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                <DataGrid ItemsSource="{Binding Rows}"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Store qty" Binding="{Binding StoreQty, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
