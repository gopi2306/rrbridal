<UserControl x:Class="RRBridal.StoreBilling.App.Views.VoucherGatewayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BrushBackground}"
             Focusable="True"
             Loaded="VoucherGatewayView_OnLoaded"
             PreviewKeyDown="VoucherGatewayView_OnPreviewKeyDown">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Accounting Vouchers" Style="{StaticResource TextPageTitleAccent}"/>
            <TextBlock Text="Tally-style create · pick a type and press Enter (or 1–6)"
                       Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="COD Receipt…" Style="{StaticResource OutlineButton}" MinWidth="120" Margin="0,0,8,0"
                                    ToolTip="Collect online COD payment (Online Sales)"
                                    Command="{Binding OpenCodReceiptVoucherCommand}"/>
                            <Button Content="Create (Enter)" Style="{StaticResource PrimaryButton}" MinWidth="130"
                                    Command="{Binding OpenSelectedCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <ListBox x:Name="VoucherList"
                         ItemsSource="{Binding Types}"
                         SelectedItem="{Binding SelectedType}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="VoucherList_OnMouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,12"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="6"
                                        Background="{StaticResource BrushBackground}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ShortcutKey}"
                                               FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushAccent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                   Text="Sales → Billing · Receipt → Credit Bills · Payment → cash withdrawal · Credit Note → Returns · Journal → Adjustments · Daily Expense → Expenses"/>
    </Grid>
</UserControl>
