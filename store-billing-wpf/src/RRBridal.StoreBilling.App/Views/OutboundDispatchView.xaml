<UserControl x:Class="RRBridal.StoreBilling.App.Views.OutboundDispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:RRBridal.StoreBilling.App.Services.Ui"
             xmlns:dispatch="clr-namespace:RRBridal.StoreBilling.App.Services.Dispatch"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1200"
             AutomationProperties.AutomationId="outbound-dispatch-page"
             AutomationProperties.Name="Outbound dispatch"
             Background="{StaticResource BrushBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Outbound Dispatch" Style="{StaticResource TextPageTitleAccent}"/>
                <TextBlock Text="Create parcel dispatches, track handover and delivery, group batches, and print documents"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource StatusChip}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentStatus}" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding DispatchNo, StringFormat=  ·  {0}}" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource FilterBarCard}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Width="230" Margin="0,0,8,6">
                        <TextBlock Text="Posted bill no / customer / mobile" Style="{StaticResource FilterFieldLabel}"/>
                        <TextBox Text="{Binding BillSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RoundedTextBox}" KeyDown="BillSearch_KeyDown"/>
                    </StackPanel>
                    <Button Content="Search posted bills" Command="{Binding SearchBillsCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,18,8,6"/>
                    <Button Content="Load selected bill" Command="{Binding LoadSelectedBillCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,18,8,6"/>
                    <TextBlock Text="{Binding LoadedBillNo, StringFormat=Loaded bill: {0}}"
                               VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,18,0,6"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding BillResults}" SelectedItem="{Binding SelectedBill}"
                          Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="125"
                          MouseDoubleClick="BillResults_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill no" Binding="{Binding BillNo}" Width="150"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding BillDate}" Width="105"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding CustomerPhone}" Width="120"/>
                        <DataGridTextColumn Header="Payable" Binding="{Binding Payable, StringFormat=₹ {0:N2}}" Width="110"/>
                        <DataGridTextColumn Header="Counter" Binding="{Binding CounterDisplay}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10"
                    IsEnabled="{Binding CanEditDraft}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="310">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Dispatch editor" Style="{StaticResource TextSectionTitle}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AddressSource, StringFormat=Address source: {0}}"
                                       Style="{StaticResource TextCaption}"/>
                        </DockPanel>
                        <TextBlock Text="Ship to" Style="{StaticResource FormFieldLabel}" Foreground="{StaticResource BrushAccent}"/>
                        <UniformGrid ui:UniformGridColumnsBehavior.IsEnabled="True"
                                     ui:UniformGridColumnsBehavior.CompactColumns="1"
                                     ui:UniformGridColumnsBehavior.MediumColumns="2"
                                     ui:UniformGridColumnsBehavior.WideColumns="4">
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Name *" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding ShipToName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Phone" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding ShipToPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Address line 1 *" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Address line 2" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="City" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="State" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Pincode" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding Pincode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,0,6"><TextBlock Text="Landmark" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding Landmark, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Parcel and fee" Style="{StaticResource FormFieldLabel}" Foreground="{StaticResource BrushAccent}" Margin="0,5,0,0"/>
                        <UniformGrid ui:UniformGridColumnsBehavior.IsEnabled="True"
                                     ui:UniformGridColumnsBehavior.CompactColumns="1"
                                     ui:UniformGridColumnsBehavior.MediumColumns="3"
                                     ui:UniformGridColumnsBehavior.WideColumns="6">
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Carrier type" Style="{StaticResource FormFieldLabel}"/><ComboBox ItemsSource="{Binding CarrierTypes}" SelectedItem="{Binding CarrierType}" Style="{StaticResource RoundedComboBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Carrier name" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding CarrierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Tracking no" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding TrackingNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Packages" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding PackageCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Fee payer" Style="{StaticResource FormFieldLabel}"/><ComboBox ItemsSource="{Binding FeePayers}" SelectedItem="{Binding FeePayer}" Style="{StaticResource RoundedComboBox}"/></StackPanel>
                            <StackPanel Margin="0,0,0,6"><TextBlock Text="Fee (₹)" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Payment mode" Style="{StaticResource FormFieldLabel}"/><ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding FeePaymentMode}" Style="{StaticResource RoundedComboBox}"/></StackPanel>
                            <StackPanel Margin="0,0,8,6"><TextBlock Text="Payment reference" Style="{StaticResource FormFieldLabel}"/><TextBox Text="{Binding FeePaymentReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" MinHeight="180">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Bottom">
                        <StackPanel Width="145" Margin="0,0,8,4"><TextBlock Text="Business date" Style="{StaticResource FilterFieldLabel}"/><DatePicker SelectedDate="{Binding FilterBusinessDate}" Style="{StaticResource RoundedDatePicker}"/></StackPanel>
                        <StackPanel Width="135" Margin="0,0,8,4"><TextBlock Text="Status" Style="{StaticResource FilterFieldLabel}"/><ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource RoundedComboBox}"/></StackPanel>
                        <StackPanel Width="145" Margin="0,0,8,4"><TextBlock Text="Batch no" Style="{StaticResource FilterFieldLabel}"/><TextBox Text="{Binding FilterBatchNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                        <StackPanel Width="190" Margin="0,0,8,4"><TextBlock Text="Search" Style="{StaticResource FilterFieldLabel}"/><TextBox Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"/></StackPanel>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" Margin="0,18,8,4"/>
                        <Button Content="Open selected" Command="{Binding OpenSelectedDispatchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,4"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Dispatches}" SelectedItem="{Binding SelectedDispatch}"
                              Style="{StaticResource ThemedDataGrid}" AutoGenerateColumns="False"
                              IsReadOnly="False" CanUserAddRows="False" SelectionMode="Single"
                              MouseDoubleClick="Dispatches_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Batch" Binding="{Binding IsBatchSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="Dispatch no" Binding="{Binding DispatchNo}" IsReadOnly="True" Width="145"/>
                            <DataGridTextColumn Header="Bill no" Binding="{Binding BillNo}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding BusinessDate}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Batch no" Binding="{Binding BatchNo}" IsReadOnly="True" Width="130"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Carrier" Binding="{Binding Carrier}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Tracking" Binding="{Binding TrackingNo}" IsReadOnly="True" Width="120"/>
                            <DataGridTextColumn Header="Payer" Binding="{Binding FeePayer}" IsReadOnly="True" Width="75"/>
                            <DataGridTextColumn Header="Fee" Binding="{Binding FeeDisplay}" IsReadOnly="True" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ActionFooterCard}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource BrushTextMuted}"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Border Style="{StaticResource StatusChip}" Margin="0,0,6,3"><TextBlock Text="{Binding BatchCustomerTotal, StringFormat=Customer fees {0}}"/></Border>
                            <Border Style="{StaticResource StatusChip}" Margin="0,0,6,3"><TextBlock Text="{Binding BatchStoreTotal, StringFormat=Store fees {0}}"/></Border>
                            <Border Style="{StaticResource StatusChip}" Margin="0,0,6,3"><TextBlock Text="{Binding BatchGrandTotal, StringFormat=Selected total {0}}" FontWeight="Bold"/></Border>
                            <Button Content="Assign common batch" Command="{Binding AssignBatchCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,6,3"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Save Draft" Command="{Binding SaveDraftCommand}" Style="{StaticResource PrimaryButton}" Margin="4,0,0,4"/>
                            <Button Content="Ready" Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static dispatch:OutboundDispatchStatus.Ready}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Handed Over" Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static dispatch:OutboundDispatchStatus.HandedOver}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Delivered" Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static dispatch:OutboundDispatchStatus.Delivered}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Returned" Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static dispatch:OutboundDispatchStatus.Returned}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Cancelled" Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static dispatch:OutboundDispatchStatus.Cancelled}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Right">
                            <TextBox Width="180" Text="{Binding StatusReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" ToolTip="Required for Cancelled / Returned" Margin="4,0,0,4"/>
                            <Button Content="Parcel A4" Command="{Binding PrintParcelA4Command}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Parcel Thermal" Command="{Binding PrintParcelThermalCommand}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Batch A4" Command="{Binding PrintBatchA4Command}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Batch Thermal" Command="{Binding PrintBatchThermalCommand}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Charge A4" Command="{Binding PrintChargeA4Command}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                            <Button Content="Charge Thermal" Command="{Binding PrintChargeThermalCommand}" Style="{StaticResource OutlineButton}" Margin="4,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.RowSpan="3" Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="8" Margin="0,0,12,0"/>
                    <TextBlock Text="Working…" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
