PORT=3000
MONGO_URI=mongodb://localhost:27017/rr_bridal_central
JWT_SECRET=replace_me
JWT_ISSUER=rr-bridal
JWT_AUDIENCE=rr-bridal-clients
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
# Meta WhatsApp webhook verify token (App → WhatsApp → Configuration)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=rr-bridal-wa-verify
# Flow-wise demo data (SKU-001…005, PO-1001, promos). Clear with: npm run seed:clear-test-data
SEED_TEST_DATA=false

# Production: only super_admin role + admin@gmail.com on startup (no demo stores/users)
SEED_PRODUCTION=true
# Clear demo users/roles once: npm run seed:clear-users-roles

# --- Store billing WPF client download (GET /api/admin/stores/:code/billing-client) ---
# Public URL written into each till .env as CENTRAL_API_BASE.
# Resolution order: PUBLIC_CENTRAL_API_BASE → API_PUBLIC_ORIGIN → download request host.
# Prefer API_PUBLIC_ORIGIN on AWS so media URLs and till packages share one deployment origin.
API_PUBLIC_ORIGIN=https://bridaldev.rrbazaar.in
# Optional override (leave unset to use API_PUBLIC_ORIGIN / request host):
# PUBLIC_CENTRAL_API_BASE=https://bridaldev.rrbazaar.in
# Prebuilt self-contained win-x64 folder on this host (from publish-store-billing-client.ps1).
# Must contain RRBridal.StoreBilling.App.exe. Nest does not run dotnet publish (Linux AWS).
# Used when format=zip (default).
BILLING_CLIENT_ARTIFACT_DIR=/var/lib/rr-bridal/billing-client-win-x64
# PublishSingleFile EXE path (format=exe). From dist/billing-client-win-x64-single/.
BILLING_CLIENT_SINGLE_EXE_PATH=/var/lib/rr-bridal/billing-client-win-x64-single/RRBridal.StoreBilling.App.exe

# --- MongoDB daily backup (scripts/mongo-backup/) ---
# Master switch: true = run mongodump on schedule; false = skip (exit cleanly)
BACKUP_ENABLED=false
# linux | windows — must match the script you schedule (backup-mongo.sh or backup-mongo.ps1)
BACKUP_PLATFORM=linux
# Dated dump folders root. Defaults if empty: /var/backups/rr-bridal/mongo (linux) or C:\data\rr-bridal\mongo-backups (windows)
BACKUP_PATH=/var/backups/rr-bridal/mongo
# Delete dated folders older than this many days
BACKUP_RETENTION_DAYS=10
# true = copy this .env into each day's folder as env.backup
BACKUP_INCLUDE_ENV=false
