PORT=3100
# Storefront routes are public; management routes require x-b2b-admin-key.
HOST=127.0.0.1
B2B_CORS_ORIGINS=http://localhost:5173
B2B_BODY_LIMIT=2mb
B2B_ADMIN_API_KEY=replace-with-at-least-24-random-characters
B2B_MONGO_MAX_POOL_SIZE=10
B2B_MONGO_TIMEOUT_MS=5000
B2B_FANOUT_CONCURRENCY=3

# Each URI must point to a compatible central-backend database, not a local POS cache.
# publicApiBaseUrl is the public central-backend origin used to resolve relative product media URLs.
# Use JSON on one line. Credentials shown here are placeholders only.
B2B_DATABASES=[{"key":"rrbridal_store","label":"RR Bridal Store","uri":"mongodb://localhost:27017/rrbriadl_store","publicApiBaseUrl":"http://localhost:3000","enabled":true},{"key":"bilaldev","label":"Bilal Development","uri":"mongodb://localhost:27017/bilaldev","publicApiBaseUrl":"https://bridaldev.rrbazaar.in","enabled":true},{"key":"bilalqc","label":"Bilal QC","uri":"mongodb://localhost:27017/bilalqc","publicApiBaseUrl":"https://bilalqc.example.com","enabled":true}]
